{
  "name": "@tracky/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "node ../scripts/gen-prompts.mjs",
    "lint": "eslint src test ../netlify/functions",
    "typecheck": "pnpm gen && tsc --noEmit",
    "test": "pnpm gen && vitest run",
    "bundle": "pnpm build:server && esbuild ../netlify/functions/api.mts ../netlify/functions/run-note.mts ../netlify/functions/heartbeat.mts --bundle --platform=node --format=esm --target=node22 --outdir=/tmp/tracky-functions --log-level=warning",
    "build:server": "pnpm gen && esbuild src/netlify/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --log-level=warning --external:@netlify/functions --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@tracky/shared": "workspace:*",
    "@netlify/blobs": "^11.1.7",
    "@netlify/functions": "^6.1.0",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "vitest": "^5.1.0"
  }
}
